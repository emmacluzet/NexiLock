<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="fr.doranco.nexilock.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="welcomeText"/>
    <Label>Nexilock</Label>
    <TextField fx:id="loginField" promptText="Entrez votre login" />
    <Label text="Mot de passe :" />
    <PasswordField fx:id="passwordField" promptText="Entrez votre mot de passe" />
    <Button text="Se connecter" onAction="#onHelloButtonClick"/>
</VBox>